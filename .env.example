# Copy to .env and fill in what you have. Nothing here is required -- with
# nothing set, embeddings/reranking/generation/citation-verification all run
# deterministic offline implementations (zero cost, zero API calls beyond
# fetching the corpus once).

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Force a specific provider per stage instead of auto-detecting:
# ('mock' | 'openai' unless noted)
# EMBEDDING_PROVIDER=
# RERANKER=              # 'mock' | 'llm'
# GENERATION_PROVIDER=   # 'mock' | 'openai' | 'anthropic'
# CITATION_VERIFIER=     # 'mock' | 'llm'
